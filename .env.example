# Servidor: Express publica el frontend y el backend en el mismo puerto.
PORT=3000
HOST=127.0.0.1

# Protege todos los endpoints /api/* y también se escribe en el frontend.
INTERNAL_API_KEY=CAMBIA_ESTO_POR_UN_SECRETO_LARGO

# Cuenta de Infobip.
INFOBIP_BASE_URL=https://TU_SUBDOMINIO.api.infobip.com

# SMS.
INFOBIP_SMS_API_KEY=REEMPLAZA_CON_LA_API_KEY_DE_SMS
INFOBIP_SENDER=ServiceSMS

# WhatsApp.
INFOBIP_WHATSAPP_API_KEY=REEMPLAZA_CON_LA_API_KEY_DE_WHATSAPP
INFOBIP_WHATSAPP_SENDER=12079526362
INFOBIP_WHATSAPP_TEMPLATE_NAME=mp_mujer
INFOBIP_WHATSAPP_TEMPLATE_LANGUAGE=es

# Solo como referencia administrativa; el envío usa el nombre de la plantilla.
INFOBIP_WHATSAPP_TEMPLATE_ID=1164159739637488

# Texto mostrado en el frontend y utilizado inicialmente para SMS.
DEFAULT_NOTIFICATION_MESSAGE=Bienvenida a Mujer MP. Tu espacio para cuidarte y encontrar apoyo. Descarga la app en tu celular: https://mpvirtual.mp.gob.gt/backend/mobile/store-mujer
